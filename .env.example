# Filled automatically by `neon deploy` / `neon env pull` (into .env, or .env.local if .env is missing).
# Never commit the real file. To fill by hand: Neon console -> Connect -> copy both connection strings.
#
# Pooled (host contains -pooler). Not used by CabZen yet.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
# Direct (no -pooler). Used by the app and Flyway, see src/main/java/com/cabzen/config/DatabaseConfig.java
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Admin account created at first startup if none exists (no admin sign-up page). Password: 8+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
